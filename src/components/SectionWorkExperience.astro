---
import Rubricator from './Rubricator.astro'
import {t} from '../i18n/translations'
import {getCollection} from 'astro:content'
const lang = 'en'
const resumeCollection = await getCollection('resume')

const jobs = resumeCollection[0].data.jobs
---

<section id='resume' class='px-4 lg:px-8 scroll-mt-20'>
  <div class='max-w-screen-xl mx-auto'>
    <Rubricator text={t[lang].experience}/>
    <div class='flex flex-col gap-10 mt-4 lg:mt-6'>
        {
            jobs.map((job) => (
                <div class='flex flex-col gap-5'>
                  <div>
                    <h3 class='text-2xl mb-1'>{job[lang].position}</h3>
                    <p class='text-xl pb-1'>{job[lang].company}</p>
                    <p class='text-grey mt-1 text-xl'>{job[lang].dates}</p>
                  </div>
                  <p class='text-xl text-grey max-w-screen-md' set:html={job[lang].description}/>
                </div>
            ))
        }
    </div>
  </div>
</section>

<style is:global>
    .resume-description a {
        @apply inline-block hover:scale-95 transition-all duration-300 ease-in;
    }
</style>
