---
type Props = {
  chips: string[]
  size?: 'md' | 'sm'
}
const { chips, size = 'md' } = Astro.props
---

<div class='flex flex-row flex-wrap gap-2'>
  {
    chips.map(chip => (
      <div class:list={[
        'flex justify-center leading-none border-stroke rounded-full',
        size === 'md' && 'p-2 border-2 text-lg lg:text-xl/7',
        size === 'sm' && 'px-2.5 py-1.5 border text-sm lg:text-base/6',
      ]}>
        {chip}
      </div>
    ))
  }
</div>
